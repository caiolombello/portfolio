# Optional environment variables
# Copy this file to .env.local and fill in the values you need.

# Google Search Console verification (optional)
# GOOGLE_SITE_VERIFICATION=your-verification-code

# AWS S3 for file storage (optional — only if using S3 features)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=

# Vercel Blob storage (optional — auto-set on Vercel)
# BLOB_READ_WRITE_TOKEN=

# Giscus comments (optional — configure at https://giscus.app)
# NEXT_PUBLIC_GISCUS_REPO=yourusername/yourrepo
# NEXT_PUBLIC_GISCUS_REPO_ID=
# NEXT_PUBLIC_GISCUS_CATEGORY=
# NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# LinkedIn sync (optional — syncs experiences during build)
# Get your li_at cookie from browser DevTools > Application > Cookies > linkedin.com
# LINKEDIN_COOKIE=your-li_at-cookie-value
# LINKEDIN_USERNAME=your-linkedin-username
